#!/bin/sh
# lynxOS rootFSBuilder — build a lynxOS root filesystem tarball from Arch packages.
#
# Requires: qemu-system-x86_64, qemu-img, zstd, tar, curl, 7z, sha256sum, ssh.
# The build runs in a disposable QEMU VM so the host (any distro) is never touched.
#
# Usage:
#   ./lynx-build fetch     download + verify the Arch bootstrap tarball
#   ./lynx-build rootfs    unpack it and apply the lynxOS skeleton
#   ./lynx-build vm-up     boot the build VM (rootfs on a 20G scratch disk)
#   ./lynx-build vm <cmd>  run <sh -c> inside the VM
#   ./lynx-build install   pacstrap the base system into /target inside the VM
#   ./lynx-build bundle    tar the finished rootfs into out/lynxos-rootfs-<date>-x86_64.tar.gz
#   ./lynx-build all       fetch + rootfs + install + bundle
#   ./lynx-build vm-down   stop the VM
#   ./lynx-build clean     stop the VM, delete work/
#
# Environment overrides (all optional):
#   MIRROR      Arch mirror   (default: https://geo.mirror.pkgbuild.com)
#   ISO_DATE    Arch snapshot (default: latest; pinned by `fetch` into work/release.env)
#   BOOTSTRAP   bootstrap tarball sha256 (default: pinned by `fetch`)
#   WORK        work dir      (default: ./work)
#   OUT         output dir    (default: ./out)
#   VMCPUS      VM cpus       (default: 2)
#   MEMORY      VM ram        (default: 1G)
#   SCRATCH     VM scratch disk size (default: 20G)
#   ECHO 0      don't print each command

set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$HERE"

WORK=${WORK:-$HERE/work}
OUT=${OUT:-$HERE/out}
IMG="$WORK/disk.qcow2"
PIDF="$WORK/vm.pid"

# `fetch` pins the exact release into work/release.env; `release.env` in the
# repo root is the committed fallback so offline builds stay reproducible.
MIRROR=${MIRROR:-https://geo.mirror.pkgbuild.com}
ISO_DATE=${ISO_DATE:-latest}
BOOTSTRAP_SHA=${BOOTSTRAP:-}
for envf in ./work/release.env ./release.env; do
    if [ -f "$envf" ]; then
        # shellcheck disable=SC1090
        . ./"$envf"
    fi
done

FETCH_DIR="$WORK/arch-bootstrap-$ISO_DATE"
BOOTSTRAP_TAR="$FETCH_DIR/archlinux-bootstrap-x86_64.tar.zst"
BOOTSTRAP_DIR="$FETCH_DIR/unpacked"
BOOTSTRAP_ROOT="$BOOTSTRAP_DIR/root.x86_64"

VMSSHPORT=${VMSSHPORT:-60022}
ECHO=${ECHO:-1}

log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> WARNING:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2; exit 1; }
run() {
    if [ "$ECHO" = 1 ]; then printf '\033[0;36m  %s\033[0m\n' "$*"; fi
    "$@"
}

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found on the host ($2)"; }
require_host_tools() {
    need qemu-system-x86_64 "apk add qemu-system-x86_64"
    need qemu-img           "apk add qemu-img"
    need zstd               "apk add zstd"
    need sha256sum          "coreutils"
    need curl               "apk add curl"
    need 7z                 "apk add 7zip"
    need nc                 "apk add opennetcat / netcat-openbsd"
    need ssh                "apk add openssh-client"
}

# The build VM: the bootstrap rootfs as a virtual disk (virtio, ext4),
# plus a raw scratch disk (/dev/vdb) the install step pacstraps onto.
# It boots with init=/bin/bash from the bootstrap and starts a dropbear
# sshd for the control channel (vm/seed.txt holds the authorized key).

# --- fetch -------------------------------------------------------------------
bootstrap_info() {
    # prints "<sha256> <date>" for the bootstrap tarball from the mirror
    m=$1 d=$2
    sha=$(curl -fsSL --max-time 60 "$m/iso/$d/sha256sums.txt" | \
        awk '$2=="archlinux-bootstrap-x86_64.tar.zst" {print $1; exit}')
    [ -n "$sha" ] || die "no bootstrap checksum listed for $d at $m"
    printf '%s %s\n' "$sha" "$d"
}

do_fetch() {
    mkdir -p "$WORK"

    if [ "$ISO_DATE" = latest ]; then
        log "Resolving latest Arch release"
        sha=$(curl -fsSL --max-time 60 "$MIRROR/iso/latest/sha256sums.txt" | \
            awk '$2=="archlinux-bootstrap-x86_64.tar.zst" {print $1; exit}')
        [ -n "$sha" ] || die "cannot read $MIRROR/iso/latest/sha256sums.txt"
        ISO_DATE=$(curl -fsSL --max-time 60 "$MIRROR/iso/latest/sha256sums.txt" | \
            sed -n 's/^\([0-9a-f]*\)  archlinux-\([0-9.]*\)-x86_64.iso$/\2/p' | head -n1)
        # ^ date parsed from the ISO line (bootstrap line is undated)
        [ -n "$ISO_DATE" ] || die "could not parse latest ISO date"
        # recompute paths for the resolved date
        FETCH_DIR="$WORK/arch-bootstrap-$ISO_DATE"
        BOOTSTRAP_TAR="$FETCH_DIR/archlinux-bootstrap-x86_64.tar.zst"
        BOOTSTRAP_DIR="$FETCH_DIR/unpacked"
        BOOTSTRAP_ROOT="$BOOTSTRAP_DIR/root.x86_64"
        mkdir -p "$FETCH_DIR"
    fi
    [ -n "$BOOTSTRAP_SHA" ] || BOOTSTRAP_SHA=$(bootstrap_info "$MIRROR" "$ISO_DATE" | cut -d' ' -f1)

    if [ ! -f "$BOOTSTRAP_TAR" ]; then
        log "Downloading archlinux-bootstrap-$ISO_DATE-x86_64.tar.zst (~40 MB)"
        run curl -fL --retry 3 -C - -o "$BOOTSTRAP_TAR.part" \
            "$MIRROR/iso/$ISO_DATE/archlinux-bootstrap-x86_64.tar.zst"
        mv "$BOOTSTRAP_TAR.part" "$BOOTSTRAP_TAR"
    else
        log "Bootstrap tarball already downloaded"
    fi

    log "Verifying sha256"
    echo "$BOOTSTRAP_SHA  $BOOTSTRAP_TAR" | sha256sum -c - || die "checksum mismatch"

    log "Pinning release in work/release.env"
    printf 'MIRROR=%s\nISO_DATE=%s\nBOOTSTRAP_SHA=%s\n' \
        "$MIRROR" "$ISO_DATE" "$BOOTSTRAP_SHA" > "$WORK/release.env"
}

# --- rootfs ------------------------------------------------------------------
do_rootfs() {
    [ -f "$BOOTSTRAP_TAR" ] || die "no bootstrap tarball — run './lynx-build fetch' first"

    if [ ! -d "$BOOTSTRAP_ROOT" ]; then
        log "Unpacking bootstrap rootfs"
        mkdir -p "$BOOTSTRAP_DIR"
        # It's a tar (zstd-compressed), not cpio despite the name. Untrusted
        # data: extraction only, nothing from it executes on the host.
        # No -p: let umask make dirs owner-writable (a few entries are mode
        # 0555 dirs whose owner can't write into them otherwise); exact
        # modes/owners are restored when the result is bundled from the VM.
        run zstd -dc "$BOOTSTRAP_TAR" | (cd "$BOOTSTRAP_DIR" && tar -xf - \
            --no-same-owner --no-same-permissions) || true
    else
        log "Bootstrap rootfs already unpacked"
    fi

    [ -f "$BOOTSTRAP_ROOT/.lynxos-skel" ] && { log "rootfs ready: $BOOTSTRAP_ROOT"; return 0; }

    log "Applying lynxOS skeleton"
    run cp -a skel/. "$BOOTSTRAP_ROOT/"
    run env TARGET="$BOOTSTRAP_ROOT" sh scripts/apply-skel.sh

    log "Writing lynxOS identity"
    mkdir -p "$BOOTSTRAP_ROOT/usr/lib"
    cat > "$BOOTSTRAP_ROOT/usr/lib/os-release" <<EOF
NAME="lynxOS"
PRETTY_NAME="lynxOS (Arch Linux base)"
ID=lynxos
BUILD_ID=$ISO_DATE
ANSI_COLOR="1;34"
HOME_URL="https://github.com/lynxOSX/lynxOS"
EOF
    ln -sf /usr/lib/os-release "$BOOTSTRAP_ROOT/etc/os-release"
    printf 'lynxos build VM (bootstrap)\n' > "$BOOTSTRAP_ROOT/etc/hostname"

    log "Pinning pacman mirror"
    mkdir -p "$BOOTSTRAP_ROOT/etc/pacman.d"
    printf 'Server = %s/$repo/os/$arch\n' "$MIRROR" \
        > "$BOOTSTRAP_ROOT/etc/pacman.d/mirrorlist"

    log "Seeding VM ssh access"
    mkdir -p "$BOOTSTRAP_ROOT/root/.ssh"
    # authorized key for the build VM's root (host-key checking is off in
    # vm_ssh anyway; this seed is for *authorized* keys)
    [ -f "$WORK/vm_key" ] || run ssh-keygen -q -t ed25519 -N '' -f "$WORK/vm_key"
    cp "$WORK/vm_key.pub" "$BOOTSTRAP_ROOT/root/.ssh/authorized_keys"
    chmod 700 "$BOOTSTRAP_ROOT/root/.ssh"
    chmod 600 "$BOOTSTRAP_ROOT/root/.ssh/authorized_keys"

    touch "$BOOTSTRAP_ROOT/.lynxos-skel"
    log "Rootfs ready: $BOOTSTRAP_ROOT"
}

# --- build VM ----------------------------------------------------------------
# Convert the bootstrap rootfs into a raw ext4 image usable as a VM disk.
# A file called lynx-build-vm-signal (or any file) in / signals readiness.
make_disk_image() {
    require_host_tools
    [ -d "$BOOTSTRAP_ROOT" ] || die "no rootfs — run './lynx-build rootfs' first"
    [ -f "$IMG" ] && { log "Disk image already exists"; return 0; }

    log "Creating build VM disk (raw ext4, 2G)"
    tmp="$WORK/disk.qcow2.raw"
    truncate -s 2G "$tmp"
    run mkfs.ext4 -q -F -L lynxvm "$tmp"

    log "Copying rootfs into the disk image"
    mnt="$WORK/mnt"
    run mkdir -p "$mnt"
    run mount -o loop "$tmp" "$mnt"
    trap 'umount "$mnt" 2>/dev/null || true; rm -f "$tmp.tmp"' EXIT
    # use as-root cp because we need root ownership inside the image
    # (alpine: doas/sudo available in most setups; fail loudly otherwise)
    copy="cp -a $BOOTSTRAP_ROOT/. $mnt/"
    if [ "$(id -u)" = 0 ]; then run $copy
    elif command -v doas >/dev/null; then run doas $copy
    elif command -v sudo >/dev/null; then run sudo $copy
    else die "need root to populate the disk image (run as root, or install doas/sudo)"
    fi
    run umount "$mnt"
    trap - EXIT
    mv "$tmp" "$IMG.raw"
    # qemu can boot raw directly; keep .raw
    rm -f "$IMG"
    IMG="$IMG.raw"  # not used further; left for clarity
}

# Boot the VM. The init inside comes from the bootstrap image: we pass
# init=/bin/bash style entry via -append (kernel extracted from the ISO's
# bootloader config; the bootstrap rootfs has /boot? no — see vm/ for the
# kernel). Simplest robust path: boot the ISO, but point its live system at
# our rootfs... (see docs/PLAN.md for the final approach)
vm_start() {
    require_host_tools
    [ -f "$IMG.raw" ] || make_disk_image
    [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null && { log "VM already running"; return 0; }
    mkdir -p "$WORK"
    VMSSHPORT=${VMSSHPORT:-60022}
    log "Starting build VM (ssh on 127.0.0.1:$VMSSHPORT)"
    run qemu-system-x86_64 \
        -machine q35 -cpu max -smp "${VMCPUS:-2}" -m "${MEMORY:-1G}" \
        -drive file="$IMG.raw",format=raw,if=virtio \
        -netdev user,id=n1,hostfwd=tcp:127.0.0.1:$VMSSHPORT-:22 \
        -device virtio-net-pci,netdev=n1 \
        -display none -daemonize -pidfile "$PIDF" \
        -serial "file:$WORK/vm-console.log"
    vm_wait_ssh
}

vm_wait_ssh() {
    log "Waiting for ssh on port $VMSSHPORT"
    i=0
    while [ $i -lt 90 ]; do
        if nc -z 127.0.0.1 "$VMSSHPORT" 2>/dev/null; then return 0; fi
        i=$((i+1)); sleep 1
    done
    die "VM ssh not up after 90s — see $WORK/vm-console.log"
}

vm_ssh() {
    run ssh -p "$VMSSHPORT" \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=10 \
        -i "$WORK/vm_key" root@127.0.0.1 "$@"
}

# --- install / bundle ----------------------------------------------------------
do_install() {
    die "'install' is not implemented yet — the build-VM boot flow is being
         finished; see docs/PLAN.md for the design and next steps."
}

do_bundle() {
    die "'bundle' is not implemented yet — it needs 'install' first."
}

# --- main ----------------------------------------------------------------------
case ${1:-} in
    fetch)    do_fetch ;;
    rootfs)   do_rootfs ;;
    vm-up)    vm_start ;;
    vm-down)  [ -f "$PIDF" ] && { run kill "$(cat "$PIDF")"; rm -f "$PIDF"; } || log "VM not running" ;;
    vm)       shift; vm_start; vm_ssh "$@" ;;
    install)  do_install ;;
    bundle)   do_bundle ;;
    all)      do_fetch; do_rootfs; do_install; do_bundle ;;
    clean)    [ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null || true
              rm -rf "$WORK" ;;
    *)        sed -n '1,30p' "$0"; exit 1 ;;
esac
