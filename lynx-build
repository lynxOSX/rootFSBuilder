#!/usr/bin/env python3
"""lynxOS rootFSBuilder — build a lynxOS root filesystem tarball from Arch packages.

Usage:
  ./lynx-build fetch     download + verify the Arch bootstrap tarball
  ./lynx-build rootfs    unpack it (the bootstrap is pacman's tool env)
  ./lynx-build install   pacstrap packages.txt into work/target + apply skeleton
  ./lynx-build bundle    reproducible tar.gz into out/
  ./lynx-build all       fetch + rootfs + install + bundle
  ./lynx-build clean     delete work/ (keeps the bootstrap tarball + release pin)

Environment overrides (all optional): MIRROR, ISO_DATE, BOOTSTRAP_SHA, WORK, OUT.
Requires host tools: curl, zstd, tar (GNU), gzip, sha256sum, proot.
"""

import hashlib
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

MIRROR_DEFAULT = "https://geo.mirror.pkgbuild.com"
BOOTSTRAP_FILE = "archlinux-bootstrap-x86_64.tar.zst"

HERE = Path(__file__).resolve().parent
WORK = Path(os.environ.get("WORK", str(HERE / "work")))
OUT = Path(os.environ.get("OUT", str(HERE / "out")))
TARGET = WORK / "target"

MIRROR = os.environ.get("MIRROR")
ISO_DATE = os.environ.get("ISO_DATE")
BOOTSTRAP_SHA = os.environ.get("BOOTSTRAP_SHA")

for envf in (WORK / "release.env", HERE / "release.env"):
    if envf.is_file():
        for line in envf.read_text().splitlines():
            m = re.match(r"^\s*([A-Za-z_]+)=(.*)$", line)
            if not m:
                continue
            key, value = m.groups()
            if key == "MIRROR" and MIRROR is None:
                MIRROR = value
            elif key == "ISO_DATE" and ISO_DATE is None:
                ISO_DATE = value
            elif key == "BOOTSTRAP_SHA" and BOOTSTRAP_SHA is None:
                BOOTSTRAP_SHA = value

MIRROR = MIRROR if MIRROR is not None else MIRROR_DEFAULT
ISO_DATE = ISO_DATE if ISO_DATE is not None else "latest"

FETCH_DIR = WORK / f"arch-bootstrap-{ISO_DATE}"
BOOTSTRAP_TAR = FETCH_DIR / BOOTSTRAP_FILE
BOOTSTRAP_DIR = FETCH_DIR / "unpacked"
BOOTSTRAP_ROOT = BOOTSTRAP_DIR / "root.x86_64"


def log(msg):
    print(f"\033[1;32m==>\033[0m {msg}", flush=True)


def warn(msg):
    print(f"\033[1;33m==> WARNING:\033[0m {msg}", file=sys.stderr, flush=True)


def die(msg):
    print(f"\033[1;31m==> ERROR:\033[0m {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def run(cmd, cwd=None, capture=False, quit_on_error=True, msg=None, env=None):
    shown = " ".join(
        s if "'" not in s and " " not in s else "'" + str(s).replace("'", "'\\''") + "'"
        for s in cmd
    )
    if msg:
        shown = f"{msg}: {shown}"
    print(f"\033[0;36m  {shown}\033[0m", file=sys.stderr, flush=True)
    try:
        if capture:
            r = subprocess.run(
                [str(c) for c in cmd], cwd=cwd, env=env,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            )
        else:
            r = subprocess.run([str(c) for c in cmd], cwd=cwd, env=env)
    except FileNotFoundError:
        die(f"'{cmd[0]}' not found on the host")
    if r.returncode != 0:
        if capture and r.stdout:
            print(r.stdout, file=sys.stderr)
        if quit_on_error:
            die(f"command failed (rc={r.returncode}): {cmd[0]}")
    return r


def need_tool(name, hint=""):
    if hint:
        hint = f" ({hint})"
    if shutil.which(name) is None:
        die(f"'{name}' not found on the host{hint}")


def require_host_tools():
    need_tool("curl", "apk add curl")
    need_tool("sha256sum", "coreutils")
    need_tool("zstd", "apk add zstd")
    need_tool("tar", "apk add tar (GNU)")
    need_tool("gzip", "busybox")
    need_tool("proot", "apk add proot")


def package_list():
    pkgs = []
    for line in (HERE / "packages.txt").read_text().splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            pkgs.append(stripped)
    return pkgs


def default_env():
    return {
        "HOME": "/root",
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "TERM": os.environ.get("TERM", "dumb"),
    }


def in_bootstrap(args, extra_binds=()):
    cmd = ["proot", "-0", "-R", str(BOOTSTRAP_ROOT), "-w", "/"]
    for host, guest in extra_binds:
        cmd += ["-b", f"{host}:{guest}"]
    return run(cmd + list(args), env=default_env())


def pin_mirror(root):
    mlist_dir = Path(root) / "etc" / "pacman.d"
    mlist_dir.mkdir(parents=True, exist_ok=True)
    (mlist_dir / "mirrorlist").write_text(
        f"Server = {MIRROR}/$repo/os/$arch\n"
    )


def do_fetch():
    global FETCH_DIR, BOOTSTRAP_TAR, BOOTSTRAP_DIR, BOOTSTRAP_ROOT
    global ISO_DATE, BOOTSTRAP_SHA
    WORK.mkdir(parents=True, exist_ok=True)
    resolved_date = ISO_DATE
    if ISO_DATE == "latest":
        log("Resolving latest Arch release")
        sums = run(
            ["curl", "-fsSL", "--max-time", "60",
             f"{MIRROR}/iso/latest/sha256sums.txt"],
            capture=True, msg="reading latest checksums",
        ).stdout
        sha = date = None
        for line in sums.splitlines():
            parts = line.split()
            if len(parts) != 2:
                continue
            digest, name = parts
            if name == BOOTSTRAP_FILE:
                sha = digest
            m = re.match(r"^archlinux-([0-9.]+)-x86_64\.iso$", name)
            if m:
                date = m.group(1)
        if not date or not sha:
            die(f"could not parse the latest release from "
                f"{MIRROR}/iso/latest/sha256sums.txt")
        resolved_date, pinned_sha = date, sha
    else:
        if not BOOTSTRAP_SHA:
            r = run(
                ["curl", "-fsSL", "--max-time", "60",
                 f"{MIRROR}/iso/{ISO_DATE}/sha256sums.txt"],
                capture=True,
            )
            match = re.search(
                r"^([0-9a-f]{64})\s+" + re.escape(BOOTSTRAP_FILE) + r"$",
                r.stdout, re.M,
            )
            pinned_sha = match.group(1) if match else None
            if not pinned_sha:
                die(f"no bootstrap checksum listed for {ISO_DATE} at {MIRROR}")
        else:
            pinned_sha = BOOTSTRAP_SHA

    FETCH_DIR = WORK / f"arch-bootstrap-{resolved_date}"
    BOOTSTRAP_TAR = FETCH_DIR / BOOTSTRAP_FILE
    BOOTSTRAP_DIR = FETCH_DIR / "unpacked"
    BOOTSTRAP_ROOT = BOOTSTRAP_DIR / "root.x86_64"
    FETCH_DIR.mkdir(parents=True, exist_ok=True)

    if not BOOTSTRAP_TAR.is_file():
        log(f"Downloading {BOOTSTRAP_FILE} ({resolved_date}, ~40 MB)")
        run(["curl", "-fL", "--retry", "3", "-C", "-", "-o",
             str(BOOTSTRAP_TAR) + ".part",
             f"{MIRROR}/iso/{resolved_date}/{BOOTSTRAP_FILE}"])
        (Path(str(BOOTSTRAP_TAR) + ".part")).replace(BOOTSTRAP_TAR)
    else:
        log("Bootstrap tarball already downloaded")

    log("Verifying sha256")
    digest = hashlib.sha256(BOOTSTRAP_TAR.read_bytes()).hexdigest()
    if digest != pinned_sha:
        die(f"checksum mismatch for {BOOTSTRAP_TAR}\n"
            f"  expected {pinned_sha}\n  found   {digest}")

    ISO_DATE = resolved_date
    BOOTSTRAP_SHA = pinned_sha
    (WORK / "release.env").write_text(
        f"MIRROR={MIRROR}\nISO_DATE={ISO_DATE}\nBOOTSTRAP_SHA={BOOTSTRAP_SHA}\n"
    )


def do_rootfs():
    require_host_tools()
    if not BOOTSTRAP_TAR.is_file():
        die(f"no bootstrap tarball ({BOOTSTRAP_TAR}) — run './lynx-build fetch' first")
    if not BOOTSTRAP_ROOT.is_dir():
        log("Unpacking bootstrap rootfs")
        if BOOTSTRAP_DIR.exists():
            shutil.rmtree(BOOTSTRAP_DIR)
        BOOTSTRAP_DIR.mkdir(parents=True)
        zstd = subprocess.Popen(
            ["zstd", "-dc", str(BOOTSTRAP_TAR)], stdout=subprocess.PIPE
        )
        tar = subprocess.Popen(
            ["tar", "-xf", "-", "--no-same-owner", "--delay-directory-restore",
             "--warning=no-unknown-keyword"],
            cwd=str(BOOTSTRAP_DIR), stdin=zstd.stdout,
        )
        zstd.stdout.close()
        rc_zstd = zstd.wait()
        rc_tar = tar.wait()
        if rc_tar != 0:
            die(f"tar failed while unpacking the bootstrap (rc={rc_tar})")
        if rc_zstd != 0:
            die(f"zstd failed while unpacking the bootstrap (rc={rc_zstd})")
        run(["chmod", "-R", "u+w", str(BOOTSTRAP_ROOT)])
    else:
        log("Bootstrap rootfs already unpacked")

    if not (BOOTSTRAP_ROOT / "usr/bin/pacman").is_file():
        die(f"bootstrap rootfs looks broken (no /usr/bin/pacman in {BOOTSTRAP_ROOT})")
    if not (BOOTSTRAP_ROOT / "etc/pacman.d/gnupg/trustdb.gpg").is_file():
        warn("bootstrap keyring missing; pacman signatures will fail until "
             "pacman-key is run inside the bootstrap")

    log("Pinning pacman mirror in bootstrap")
    pin_mirror(BOOTSTRAP_ROOT)
    log(f"Bootstrap ready: {BOOTSTRAP_ROOT}")


def build_pacman_conf():
    conf = BOOTSTRAP_ROOT / "etc" / "pacman.conf"
    text = conf.read_text()
    out = []
    for line in text.splitlines():
        if line.startswith("DownloadUser"):
            out.append("#" + line)
        elif line.startswith("#DisableSandboxFilesystem"):
            out.append(line[1:])
        elif line.startswith("#DisableSandboxSyscalls"):
            out.append(line[1:])
        else:
            out.append(line)
    newconf = BOOTSTRAP_ROOT / "etc" / "pacman.conf.lynxbuild"
    newconf.write_text("\n".join(out) + "\n")
    return "/etc/pacman.conf.lynxbuild"


def build_keyring(dest_root):
    """Populate dest_root/etc/pacman.d/gnupg with a working pacman keyring.

    The bootstrap tarball ships no /etc/pacman.d/gnupg and pacman-key cannot
    run under proot (gpg-agent hangs waiting on sockets, and gpg refuses a
    homedir owned by another uid), so the keyring is built on the host with
    the host's gpg:
      - import the full Arch keyring (usr/share/pacman/keyrings/archlinux.gpg)
      - mark every key in archlinux-trusted owner-ultimate (:6:) so the web
        of trust resolves for package signatures
    """
    need_tool("gpg", "apk add gnupg")
    keyrings = BOOTSTRAP_ROOT / "usr" / "share" / "pacman" / "keyrings"
    for f in (keyrings / "archlinux.gpg", keyrings / "archlinux-trusted"):
        if not f.is_file():
            die(f"missing keyring file in bootstrap: {f}")

    tmp = WORK / "gnupg"
    tmp.mkdir(parents=True, exist_ok=True)
    os.chmod(tmp, 0o700)
    genv = dict(os.environ, GNUPGHOME=str(tmp))
    if not (tmp / "pubring.kbx").is_file():
        log("Building pacman keyring on the host (one-time)")
        run(["gpg", "--batch", "--quiet", "--import", str(keyrings / "archlinux.gpg")],
            env=genv, msg="importing archlinux.gpg")
        trusted = (keyrings / "archlinux-trusted").read_text().replace(":4:", ":6:")
        (tmp / "ownertrust").write_text(trusted)
        run(["gpg", "--batch", "--quiet", "--import-ownertrust",
             str(tmp / "ownertrust")], env=genv, msg="setting owner trust")
        run(["gpg", "--batch", "--quiet", "--list-keys"],
            env=genv, msg="computing trustdb",
            quit_on_error=False)

    dst = Path(dest_root) / "etc" / "pacman.d" / "gnupg"
    if dst.exists():
        shutil.rmtree(dst)
    dst.mkdir(parents=True)
    for name in ("pubring.kbx", "trustdb.gpg"):
        shutil.copy2(tmp / name, dst / name)
    os.chmod(dst, 0o700)
    for f in dst.iterdir():
        f.chmod(0o600 if not f.is_dir() else 0o700)


def do_skel_dirs():
    pkg = {
        "root": "x:0:0:root:/:/bin/sh",
        "alpm": "x:970:970:Arch Linux Package Management:/:/usr/bin/nologin",
    }
    etc = TARGET / "etc"
    etc.mkdir(parents=True, exist_ok=True)
    for name, entry in pkg.items():
        (etc / "passwd").touch()
        content = (etc / "passwd").read_text()
        if f"\n{name}:" not in "\n" + content and not content.startswith(name + ":"):
            with open(etc / "passwd", "a") as f:
                f.write(f"{name}:{entry}\n")
        (etc / "group").touch()
        gcontent = (etc / "group").read_text()
        if f"\n{name}:" not in "\n" + gcontent and not gcontent.startswith(name + ":"):
            with open(etc / "group", "a") as f:
                f.write(f"{name}:x:{'0' if name == 'root' else '970'}:\n")


def do_install():
    require_host_tools()
    if not BOOTSTRAP_ROOT.is_dir():
        die("no bootstrap rootfs — run './lynx-build rootfs' first")
    if not (BOOTSTRAP_ROOT / "usr/bin/pacman").is_file():
        die("bootstrap rootfs looks broken (no /usr/bin/pacman)")
    if TARGET.exists():
        die(f"{TARGET} already exists — run './lynx-build clean' to restart")
    pkgs = package_list()
    if not pkgs:
        die("packages.txt is empty")

    TARGET.mkdir(parents=True)
    (TARGET / "var" / "lib" / "pacman").mkdir(parents=True, exist_ok=True)
    do_skel_dirs()

    log("Preparing pacman keyring (host-built, into bootstrap)")
    build_keyring(BOOTSTRAP_ROOT)
    log("Copying pacman keyring into target")
    build_keyring(TARGET)

    build_conf = build_pacman_conf()
    log(f"Installing package set into {TARGET} ({len(pkgs)} packages)")
    in_bootstrap([
        "pacman",
        "--config", build_conf,
        "-Sy", "--needed", "--noconfirm",
        "-r", "/target",
        *pkgs,
    ], extra_binds=[(TARGET, "/target")])

    log("Applying lynxOS skeleton")
    skel = HERE / "skel"
    if skel.is_dir():
        run(["cp", "-a", str(skel) + "/.", str(TARGET) + "/"])
    else:
        warn("no skel/ directory — apply-skel.sh provides the skeleton for now")
    run(["sh", str(HERE / "scripts" / "apply-skel.sh")],
        env={**os.environ, "TARGET": str(TARGET)})

    log("Writing lynxOS identity")
    rdir = TARGET / "usr" / "lib"
    rdir.mkdir(parents=True, exist_ok=True)
    (rdir / "os-release").write_text(
        "NAME=\"lynxOS\"\n"
        "PRETTY_NAME=\"lynxOS (Arch Linux base)\"\n"
        "ID=lynxos\n"
        f"BUILD_ID={ISO_DATE}\n"
        "ANSI_COLOR=\"1;34\"\n"
        "HOME_URL=\"https://github.com/lynxOSX/lynxOS\"\n"
    )
    rel = TARGET / "etc" / "os-release"
    if rel.is_symlink() or rel.exists():
        rel.unlink()
    rel.symlink_to("/usr/lib/os-release")
    (TARGET / "etc" / "hostname").write_text("lynxos\n")

    log("Pinning pacman mirror in target")
    pin_mirror(TARGET)

    btgt = TARGET / "usr" / "bin" / "pacman"
    if not btgt.exists():
        die("install failed: pacman missing from the target rootfs")
    run(["chmod", "-R", "u+rwX", str(TARGET)])
    log(f"Install complete: {TARGET}")


def do_bundle():
    require_host_tools()
    if not (TARGET / "usr/lib/os-release").is_file():
        die("no installed rootfs — run './lynx-build install' first")
    run(["chmod", "-R", "u+rwX", str(TARGET)], msg="widening perms")
    OUT.mkdir(parents=True, exist_ok=True)
    name = f"lynxos-rootfs-{ISO_DATE}-x86_64.tar.gz"
    tar_flags = [
        "--numeric-owner", "--sort=name", "--owner=0:0", "--group=0:0",
        "--mtime=1970-01-01 00:00:00 UTC",
    ]
    build = out_path = OUT / name
    tmp = OUT / (name + ".tmp")
    log(f"Bundling {TARGET}")
    run(["tar", *tar_flags, "-C", str(TARGET), "-czf", str(tmp), "."])
    tmp.replace(build)
    size = build.stat().st_size
    log(f"Wrote {build} ({size / (1 << 20):.1f} MiB)")

    digest = hashlib.sha256(build.read_bytes()).hexdigest()
    log(f"sha256 {digest}")

    verify = OUT / (name + ".verify")
    log("Verifying reproducibility (second pass)")
    run(["tar", *tar_flags, "-C", str(TARGET), "-czf", str(verify), "."])
    second = hashlib.sha256(verify.read_bytes()).hexdigest()
    verify.unlink()
    if second != digest:
        die(f"bundle is not reproducible: {digest} != {second}")
    log("Reproducible: two passes produced identical bytes")


def do_clean():
    stash = Path(str(WORK) + ".stash")
    stash.mkdir(parents=True, exist_ok=True)
    if BOOTSTRAP_TAR.is_file():
        shutil.move(str(BOOTSTRAP_TAR), str(stash / BOOTSTRAP_FILE))
    if (WORK / "release.env").is_file():
        shutil.move(str(WORK / "release.env"), str(stash / "release.env"))
    if WORK.is_dir():
        run(["chmod", "-R", "u+rwX", str(WORK)], quit_on_error=False)
        shutil.rmtree(WORK)
    WORK.mkdir(parents=True, exist_ok=True)
    fetch_dir = WORK / f"arch-bootstrap-{ISO_DATE}"
    fetch_dir.mkdir(parents=True, exist_ok=True)
    if (stash / BOOTSTRAP_FILE).is_file():
        shutil.move(str(stash / BOOTSTRAP_FILE), str(BOOTSTRAP_TAR))
    if (stash / "release.env").is_file():
        shutil.move(str(stash / "release.env"), str(WORK / "release.env"))
    try:
        stash.rmdir()
    except OSError:
        pass
    OUT.mkdir(parents=True, exist_ok=True)


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0 if len(sys.argv) == 2 else 2)
    step = sys.argv[1]
    steps = {
        "fetch": do_fetch,
        "rootfs": do_rootfs,
        "install": do_install,
        "bundle": do_bundle,
        "clean": do_clean,
    }
    if step == "all":
        for s in ("fetch", "rootfs", "install", "bundle"):
            log(s)
            steps[s]()
        return
    if step not in steps:
        die(f"unknown step '{step}' — try fetch|rootfs|install|bundle|all|clean")
    steps[step]()


if __name__ == "__main__":
    main()
